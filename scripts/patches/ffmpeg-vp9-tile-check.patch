+/* Reel: the exit process of the VP9 boolean decoder (spec 9.2.3). The bits after a tile's last
+ * symbol are padding, which a conforming stream sets to zero; damaged tile data almost always
+ * leaves the decoder somewhere else. Returns 1 when the padding is all zero. Checked only when
+ * err_recognition has AV_EF_BITSTREAM; a failure returns AVERROR(EBADMSG). */
+static int vp9_tile_padding_ok(const VPXRangeCoder *c, const uint8_t *start, int64_t size)
+{
+    int64_t pos = 8 * (int64_t)(c->buffer - start) + c->bits;
+    int64_t byte;
+
+    if (pos > 8 * size)
+        return 0;
+    byte = pos >> 3;
+    if (pos & 7) {
+        if (start[byte] & (0xff >> (pos & 7)))
+            return 0;
+        byte++;
+    }
+    for (; byte < size; byte++)
+        if (start[byte])
+            return 0;
+    return 1;
+}
