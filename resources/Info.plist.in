<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleDevelopmentRegion</key><string>en</string>
  <key>CFBundleExecutable</key><string>Reel</string>
  <key>CFBundleIdentifier</key><string>@BUNDLE_ID@</string>
  <key>CFBundleInfoDictionaryVersion</key><string>6.0</string>
  <key>CFBundleName</key><string>Reel</string>
  <key>CFBundleDisplayName</key><string>Reel</string>
  <key>CFBundlePackageType</key><string>APPL</string>
  <key>CFBundleShortVersionString</key><string>@VERSION@</string>
  <key>CFBundleVersion</key><string>@BUILD@</string>
  <key>CFBundleIconFile</key><string>AppIcon</string>
  <key>LSApplicationCategoryType</key><string>public.app-category.video</string>
  <key>LSMinimumSystemVersion</key><string>27.0</string>
  <key>NSHighResolutionCapable</key><true/>
  <key>NSPrincipalClass</key><string>NSApplication</string>
  <key>NSSupportsAutomaticTermination</key><false/>
  <key>NSSupportsSuddenTermination</key><false/>

  <!-- Shelf quick actions (shelf design, section 11): reel://<action>, allowlisted in ShelfURL. -->
  <key>CFBundleURLTypes</key>
  <array>
    <dict>
      <key>CFBundleURLName</key><string>@BUNDLE_ID@.shelf</string>
      <key>CFBundleTypeRole</key><string>Viewer</string>
      <key>CFBundleURLSchemes</key>
      <array><string>reel</string></array>
    </dict>
  </array>
  <key>SDShelfActions</key>
  <array><string>open-recent</string><string>check-for-updates</string></array>

  <!-- Sparkle auto-update (app-updates CONTRACT.md). -->
  <key>SUFeedURL</key><string>https://sdusteric.github.io/app-updates/reel/appcast.xml</string>
  <key>SUPublicEDKey</key><string>PMaW+8sZRzOkfIwy1KBGk0CHTVoN49FE9o8gUlNGdZc=</string>
  <key>SUEnableAutomaticChecks</key><true/>
  <key>SUAutomaticallyUpdate</key><true/>
  <key>SUScheduledCheckInterval</key><integer>86400</integer>

  <!-- Folder access (design 9.12): the episode list and sidecar subtitles list the video's folder. -->
  <key>NSDocumentsFolderUsageDescription</key>
  <string>Reel lists the other videos and subtitle files in the folder of the video you open.</string>
  <key>NSDownloadsFolderUsageDescription</key>
  <string>Reel lists the other videos and subtitle files in the folder of the video you open.</string>
  <key>NSDesktopFolderUsageDescription</key>
  <string>Reel lists the other videos and subtitle files in the folder of the video you open.</string>
  <key>NSRemovableVolumesUsageDescription</key>
  <string>Reel lists the other videos and subtitle files in the folder of the video you open.</string>

  <!-- Default app (design 9.12): Viewer, rank Default. The user picks Reel in Finder; Reel never
       claims the types through LaunchServices. Where another app declares a type under its own
       identifier (io.iina.mkv, com.adobe.flash.video), that identifier is listed as well. -->
  <key>CFBundleDocumentTypes</key>
  <array>
    <dict>
      <key>CFBundleTypeName</key><string>MPEG-4 Video</string>
      <key>CFBundleTypeRole</key><string>Viewer</string>
      <key>LSHandlerRank</key><string>Default</string>
      <key>LSItemContentTypes</key>
      <array><string>public.mpeg-4</string><string>com.apple.m4v-video</string></array>
      <key>CFBundleTypeExtensions</key>
      <array><string>mp4</string><string>m4v</string></array>
    </dict>
    <dict>
      <key>CFBundleTypeName</key><string>QuickTime Movie</string>
      <key>CFBundleTypeRole</key><string>Viewer</string>
      <key>LSHandlerRank</key><string>Default</string>
      <key>LSItemContentTypes</key>
      <array><string>com.apple.quicktime-movie</string></array>
      <key>CFBundleTypeExtensions</key>
      <array><string>mov</string></array>
    </dict>
    <dict>
      <key>CFBundleTypeName</key><string>Matroska Video</string>
      <key>CFBundleTypeRole</key><string>Viewer</string>
      <key>LSHandlerRank</key><string>Default</string>
      <key>LSItemContentTypes</key>
      <array><string>org.matroska.mkv</string><string>io.iina.mkv</string></array>
      <key>CFBundleTypeExtensions</key>
      <array><string>mkv</string></array>
    </dict>
    <dict>
      <key>CFBundleTypeName</key><string>WebM Video</string>
      <key>CFBundleTypeRole</key><string>Viewer</string>
      <key>LSHandlerRank</key><string>Default</string>
      <key>LSItemContentTypes</key>
      <array><string>org.webmproject.webm</string></array>
      <key>CFBundleTypeExtensions</key>
      <array><string>webm</string></array>
    </dict>
    <dict>
      <key>CFBundleTypeName</key><string>AVI Video</string>
      <key>CFBundleTypeRole</key><string>Viewer</string>
      <key>LSHandlerRank</key><string>Default</string>
      <key>LSItemContentTypes</key>
      <array><string>public.avi</string></array>
      <key>CFBundleTypeExtensions</key>
      <array><string>avi</string></array>
    </dict>
    <dict>
      <key>CFBundleTypeName</key><string>Flash Video</string>
      <key>CFBundleTypeRole</key><string>Viewer</string>
      <key>LSHandlerRank</key><string>Default</string>
      <key>LSItemContentTypes</key>
      <array><string>com.adobe.flash-video</string><string>com.adobe.flash.video</string></array>
      <key>CFBundleTypeExtensions</key>
      <array><string>flv</string></array>
    </dict>
    <dict>
      <key>CFBundleTypeName</key><string>MPEG-2 Transport Stream</string>
      <key>CFBundleTypeRole</key><string>Viewer</string>
      <key>LSHandlerRank</key><string>Default</string>
      <key>LSItemContentTypes</key>
      <array>
        <string>public.mpeg-2-transport-stream</string>
        <string>public.avchd-mpeg-2-transport-stream</string>
      </array>
      <key>CFBundleTypeExtensions</key>
      <array><string>ts</string><string>m2ts</string><string>mts</string></array>
    </dict>
    <dict>
      <key>CFBundleTypeName</key><string>MPEG Video</string>
      <key>CFBundleTypeRole</key><string>Viewer</string>
      <key>LSHandlerRank</key><string>Default</string>
      <key>LSItemContentTypes</key>
      <array><string>public.mpeg</string><string>public.mpeg-2-video</string></array>
      <key>CFBundleTypeExtensions</key>
      <array><string>mpg</string><string>mpeg</string><string>m2v</string></array>
    </dict>
    <dict>
      <key>CFBundleTypeName</key><string>DVD Video Object</string>
      <key>CFBundleTypeRole</key><string>Viewer</string>
      <key>LSHandlerRank</key><string>Default</string>
      <key>CFBundleTypeExtensions</key>
      <array><string>vob</string></array>
    </dict>
    <dict>
      <key>CFBundleTypeName</key><string>H.264 or HEVC Stream</string>
      <key>CFBundleTypeRole</key><string>Viewer</string>
      <key>LSHandlerRank</key><string>Default</string>
      <key>CFBundleTypeExtensions</key>
      <array><string>h264</string><string>264</string><string>hevc</string><string>265</string></array>
    </dict>
    <dict>
      <key>CFBundleTypeName</key><string>Ogg Video</string>
      <key>CFBundleTypeRole</key><string>Viewer</string>
      <key>LSHandlerRank</key><string>Default</string>
      <key>LSItemContentTypes</key>
      <array><string>org.xiph.ogv</string></array>
      <key>CFBundleTypeExtensions</key>
      <array><string>ogv</string></array>
    </dict>
    <dict>
      <key>CFBundleTypeName</key><string>Audio</string>
      <key>CFBundleTypeRole</key><string>Viewer</string>
      <key>LSHandlerRank</key><string>Default</string>
      <key>LSItemContentTypes</key>
      <array>
        <string>public.mp3</string>
        <string>public.aac-audio</string>
        <string>org.xiph.flac</string>
        <string>com.microsoft.waveform-audio</string>
        <string>org.xiph.ogg-audio</string>
      </array>
      <key>CFBundleTypeExtensions</key>
      <array><string>mp3</string><string>aac</string><string>flac</string><string>wav</string><string>ogg</string></array>
    </dict>
  </array>

  <!-- Types macOS does not declare itself (design 9.12). Imported, so a system or app declaration wins. -->
  <key>UTImportedTypeDeclarations</key>
  <array>
    <dict>
      <key>UTTypeIdentifier</key><string>org.matroska.mkv</string>
      <key>UTTypeDescription</key><string>Matroska Video</string>
      <key>UTTypeConformsTo</key><array><string>public.movie</string></array>
      <key>UTTypeTagSpecification</key>
      <dict>
        <key>public.filename-extension</key><array><string>mkv</string></array>
        <key>public.mime-type</key><array><string>video/x-matroska</string></array>
      </dict>
    </dict>
    <dict>
      <key>UTTypeIdentifier</key><string>org.webmproject.webm</string>
      <key>UTTypeDescription</key><string>WebM Video</string>
      <key>UTTypeConformsTo</key><array><string>public.movie</string></array>
      <key>UTTypeTagSpecification</key>
      <dict>
        <key>public.filename-extension</key><array><string>webm</string></array>
        <key>public.mime-type</key><array><string>video/webm</string></array>
      </dict>
    </dict>
    <dict>
      <key>UTTypeIdentifier</key><string>com.adobe.flash-video</string>
      <key>UTTypeDescription</key><string>Flash Video</string>
      <key>UTTypeConformsTo</key><array><string>public.movie</string></array>
      <key>UTTypeTagSpecification</key>
      <dict>
        <key>public.filename-extension</key><array><string>flv</string></array>
        <key>public.mime-type</key><array><string>video/x-flv</string></array>
      </dict>
    </dict>
    <dict>
      <key>UTTypeIdentifier</key><string>public.avi</string>
      <key>UTTypeDescription</key><string>AVI Video</string>
      <key>UTTypeConformsTo</key><array><string>public.movie</string></array>
      <key>UTTypeTagSpecification</key>
      <dict>
        <key>public.filename-extension</key><array><string>avi</string></array>
        <key>public.mime-type</key><array><string>video/avi</string><string>video/x-msvideo</string></array>
      </dict>
    </dict>
  </array>
</dict>
</plist>
